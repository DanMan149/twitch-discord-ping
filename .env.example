# Comma separated Twitch channel names (no #). Add as many as you like.
TWITCH_CHANNELS=alveussanctuary,maya

# Comma separated keywords applied to ALL channels. Case-insensitive, whole word match.
# For different keywords per channel, use channels.json (see channels.example.json)
KEYWORDS=giveaway,raid

# Discord channel webhook: Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# Your Discord user ID (enable Developer Mode, right click yourself > Copy User ID)
# Leave empty to post without pinging anyone
DISCORD_USER_ID=

# Minimum seconds between alerts for the same keyword in the same channel
COOLDOWN_SECONDS=30

# Optional: comma separated Twitch usernames to ignore (bots etc)
IGNORE_USERS=nightbot,streamelements
